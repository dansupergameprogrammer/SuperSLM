+// ---- DEBUNK MUTANT wrappers (tests/paged-kv/commissioning/mutants) -----------------------------
+
+extern "C" sslm_status sslm_decode_step(sslm_model model, sslm_seq* seqs, int32_t n,
+                                         const sslm_decode_params* params, sslm_workspace ws,
+                                         int32_t* out_tokens) {
+	const bool slow = superslm::debunk::Mutant("decode_slow") && model &&
+	                  ComputePageGeometry(model).page_positions < static_cast<int64_t>(model->view.config.context_cap);
+	const auto t0 = std::chrono::steady_clock::now();
+	const sslm_status st = DebunkDecodeStepInner(model, seqs, n, params, ws, out_tokens);
+	if (slow) {
+		const auto t1 = std::chrono::steady_clock::now();
+		const auto until = t1 + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+		                            (t1 - t0) * superslm::debunk::DecodeSlowFactor());
+		while (std::chrono::steady_clock::now() < until) {
+		}
+	}
+	if (st == SSLM_OK && superslm::debunk::Mutant("tok_flip") && n >= 1 && seqs && seqs[0] && out_tokens &&
+	    out_tokens[0] >= 0 && seqs[0]->state.context_length == 102)
+		out_tokens[0] = (out_tokens[0] + 1) % 256;
+	return st;
+}
+
+extern "C" sslm_status sslm_seq_save(sslm_seq seq, void* buf, size_t* n) {
+	const sslm_status st = DebunkSeqSaveInner(seq, buf, n);
+	if (st == SSLM_OK && buf && n && *n > 100 && superslm::debunk::Mutant("blob_hdr"))
+		static_cast<uint8_t*>(buf)[100] ^= 1;
+	return st;
+}
