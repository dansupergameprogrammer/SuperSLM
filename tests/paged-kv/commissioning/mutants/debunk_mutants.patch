+// DEBUNK MUTANT -- never part of a shipped tree. Applied only to a scratch copy by
+// tests/paged-kv/commissioning/build_scratch.{sh,ps1} (mutants/debunk_mutants.patch).
+//
+// Every mutation is gated on PKV_DEBUNK_MUTANT (read once per process), so one mutant library
+// serves every construction, and with the variable unset it behaves as the unmutated tree.
+//   leak1          the first release in each page pool leaks one reserve page (one-page deficit)
+//   dfree1         the first release in each page pool frees one reserve page twice (one-page excess)
+//   budget_edge    sslm_seq_create_budgeted refuses budget >= cap - B with SSLM_INVALID_ARGUMENT
+//   kv_flip        one V byte (layer 1, KV head 1, position 17, d 0) lands XOR 1
+//   tok_flip       a decode step that leaves context_length == 102 returns (token + 1) % 256
+//   blob_hdr       a successful save flips bit 0 of byte 100 (forced_token_count) of the blob
+//   decode_slow    sslm_decode_step on a paged holder (B < cap) spins f x its own elapsed time,
+//                  f = PKV_DEBUNK_DECODE_SLOW (a decode rate 1 / (1 + f) of the unmutated one)
+//   reset_capscale sslm_seq_reset also writes context_cap * 64 bytes of scratch (cost ~ cap)
+
+#ifndef SUPERSLM_SRC_DEBUNK_MUTANT_H
+#define SUPERSLM_SRC_DEBUNK_MUTANT_H
+
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+namespace superslm {
+namespace debunk {
+
+inline const std::string& MutantName() {
+	static const std::string name = [] {
+		const char* v = std::getenv("PKV_DEBUNK_MUTANT");
+		return std::string(v ? v : "");
+	}();
+	return name;
+}
+
+inline bool Mutant(const char* name) { return MutantName() == name; }
+
+inline double DecodeSlowFactor() {
+	static const double f = [] {
+		const char* v = std::getenv("PKV_DEBUNK_DECODE_SLOW");
+		return v ? std::atof(v) : 0.0;
+	}();
+	return f;
+}
+
+}  // namespace debunk
+}  // namespace superslm
+
+#endif  // SUPERSLM_SRC_DEBUNK_MUTANT_H
